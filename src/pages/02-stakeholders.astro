---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import PrevNextNav from "../components/PrevNextNav.astro";
import PageFooter from "../components/PageFooter.astro";
import { getSectionByOrder } from "../lib/sections";

const section = await getSectionByOrder(2);
if (!section) throw new Error("Stakeholders section not found");

const description = section.summary;
const panels = section.panels ?? [];
const evParas = section.evidence.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
---

<Layout title={`${section.title} — Navigate AI Strategy`} description={description} atmosphere={section.atmosphere} position={section.order}>
  <Masthead variant="inner" position={section.order} total={5} />

  <article class="triptych">
    <header class="head">
      <p class="section-numeral">{String(section.order).padStart(2, "0")} · {section.title}</p>
      <h1 class="head-title">Three audiences. Three workloads. Three success criteria.</h1>
      <p class="head-lede">{section.summary}</p>
      <p class="head-frame">
        Most AI conversations collapse "who benefits" into one bucket. The strategy says
        the opposite: there are three primary stakeholders, and AI should be directed at
        each in a different way — as distinct workloads, not one feature stretched three ways.
      </p>
    </header>

    <figure
      class="cycle"
      role="img"
      aria-label="Cyclical flow: AI mediates work between three stakeholders. AI flags issues and drafts responses for staff. AI logs interventions and surfaces patterns for admin. Admin redesigns the journey; AI personalizes delivery for patients."
    >
      <svg viewBox="0 0 720 380" width="100%" height="auto" preserveAspectRatio="xMidYMid meet" focusable="false">
        <defs>
          <marker id="cycle-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"></path>
          </marker>
        </defs>

        {/* Three stakeholder nodes — diagram glyphs, rx=8 (smaller than the 16-radius card rule). */}
        <g class="cycle-node" data-role="patients">
          <rect x="260" y="14" width="200" height="56" rx="8" />
          <text x="360" y="46" text-anchor="middle">PATIENTS</text>
        </g>
        <g class="cycle-node" data-role="staff">
          <rect x="50" y="290" width="200" height="56" rx="8" />
          <text x="150" y="322" text-anchor="middle">STAFF</text>
        </g>
        <g class="cycle-node" data-role="admin">
          <rect x="470" y="290" width="200" height="56" rx="8" />
          <text x="570" y="322" text-anchor="middle">ADMIN</text>
        </g>

        {/* Clockwise arcs that ride the outside of the triangle. */}
        {/* (1) Patients → Staff — left arc */}
        <path
          class="cycle-arc"
          d="M 280 60 C 130 80 60 200 130 290"
          fill="none"
          marker-end="url(#cycle-arrow)"
        />
        {/* (2) Staff → Admin — bottom arc */}
        <path
          class="cycle-arc"
          d="M 250 332 C 320 366 400 366 470 332"
          fill="none"
          marker-end="url(#cycle-arrow)"
        />
        {/* (3) Admin → Patients — right arc */}
        <path
          class="cycle-arc"
          d="M 590 290 C 660 200 590 80 440 60"
          fill="none"
          marker-end="url(#cycle-arrow)"
        />

        {/* Arc labels — sentence-case body text, positioned along each arc's exterior midpoint. */}
        <text class="cycle-arc-label" x="96" y="180" text-anchor="middle">
          <tspan x="96" dy="0">AI flags issues</tspan>
          <tspan x="96" dy="16">and drafts responses</tspan>
        </text>
        <text class="cycle-arc-label" x="360" y="372" text-anchor="middle">
          AI logs interventions and surfaces patterns
        </text>
        <text class="cycle-arc-label" x="624" y="180" text-anchor="middle">
          <tspan x="624" dy="0">Admin redesigns;</tspan>
          <tspan x="624" dy="16">AI personalizes journey</tspan>
        </text>
      </svg>

      <figcaption class="cycle-caption">
        AI sits between the three stakeholders, not stretched across them.
        Each leg of the cycle is a different kind of work.
      </figcaption>
    </figure>

    <div class="panels">
      {panels.map((panel, i) => (
        <section class={`panel panel-${i}`}>
          <div class="panel-num">{String(i + 1).padStart(2, "0")}</div>
          <p class="panel-label">{panel.label}</p>
          <h2 class="panel-title">{panel.title}</h2>
          <p class="panel-body">{panel.body}</p>
        </section>
      ))}
    </div>

    <section class="footnote">
      <h3 class="footnote-heading">Evidence</h3>
      {evParas.map(p => <p>{p}</p>)}
    </section>
  </article>

  <PrevNextNav order={section.order} />
  <PageFooter />
</Layout>

<style>
  .triptych {
    max-width: 1180px;
    margin: 0 auto;
    padding: 64px var(--space-8) 64px;
  }

  .head {
    max-width: 800px;
    margin: 0 0 var(--space-12) 0;
  }

  /* ============ CYCLE GRAPHIC ============
   * Single SVG: three stakeholder nodes (Patients top, Staff bottom-left, Admin bottom-right),
   * three curved arrows clockwise. AI mediates the work on each leg.
   * Nodes are diagram glyphs (rx=8), not UI cards — matches Foundations product/eng box convention.
   */
  .cycle {
    margin: 0 auto var(--space-12);
    max-width: 760px;
    color: var(--brand-primary);
  }
  .cycle svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .cycle-node rect {
    fill: var(--surface-page);
    stroke: var(--brand-primary);
    stroke-width: 1.5;
  }
  .cycle-node text {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.14em;
    fill: var(--fg-heading);
    dominant-baseline: middle;
  }

  .cycle-arc {
    stroke: var(--brand-primary);
    stroke-width: 1.5;
    color: var(--brand-primary);  /* drives the marker-end fill via currentColor */
    opacity: 0.85;
  }

  .cycle-arc-label {
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.4;
    fill: var(--fg-secondary);
    dominant-baseline: middle;
  }

  .cycle-caption {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.55;
    color: var(--fg-secondary);
    text-align: center;
    max-width: 56ch;
    margin: var(--space-6) auto 0;
  }

  /* Mobile: stack nodes vertically. Hide curved-arc figure and render a simpler
   * vertical-arrow list. The SVG is unreadable below ~520px due to label crowding. */
  @media (max-width: 640px) {
    .cycle svg { display: none; }
    .cycle::before {
      content: "Patients → Staff → Admin → Patients";
      display: block;
      font-family: var(--font-sans);
      font-size: 0.95rem;
      font-weight: 600;
      text-align: center;
      color: var(--brand-primary);
      padding: var(--space-6) var(--space-4);
      border: 1px solid var(--border-soft);
      border-radius: var(--radius-card);
      background: var(--surface-page);
      box-shadow: var(--shadow-e1);
    }
  }
  @media print {
    .cycle-caption { color: black; }
  }
  .section-numeral {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-secondary);
    margin: 0 0 var(--space-6) 0;
  }
  .head-title {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 96, "wght" 500;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4) 0;
    color: var(--fg-heading);
    max-width: 20ch;
  }
  .head-lede {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--fg-primary);
    margin: 0 0 var(--space-6) 0;
    max-width: 60ch;
  }
  .head-frame {
    font-family: var(--font-sans);
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--fg-secondary);
    margin: 0;
    max-width: 60ch;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-soft);
  }

  /* ============ TRIPTYCH ============ */
  .panels {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--fg-heading);
  }
  .panel {
    padding: var(--space-12) var(--space-8);
    border-right: 1px solid var(--border-strong);
    background: var(--surface-page);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-height: 420px;
  }
  .panel:last-child { border-right: none; }
  /* Triptych panel tints derived from brand tokens. Subtle differentiation, no invented colors. */
  .panel-0 { background: color-mix(in srgb, var(--surface-page) 88%, var(--brand-secondary)); }
  .panel-1 { background: var(--surface-page); }
  .panel-2 { background: color-mix(in srgb, var(--surface-page) 96%, var(--brand-primary)); }

  .panel-num {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--fg-secondary);
  }
  .panel-label {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brand-primary);
    margin: 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-strong);
  }
  .panel-title {
    font-family: var(--font-display);
    font-variation-settings: "opsz" 36, "wght" 500;
    font-size: 1.45rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--fg-heading);
  }
  .panel-body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--fg-primary);
    margin: 0;
  }

  .footnote {
    margin-top: 64px;
    max-width: 800px;
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-soft);
  }
  .footnote-heading {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg-secondary);
    margin: 0 0 var(--space-4) 0;
    font-weight: 500;
  }
  .footnote p {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--fg-primary);
    margin: 0;
  }

  @media (max-width: 900px) {
    .panels { grid-template-columns: 1fr; border-top: 2px solid var(--fg-heading); }
    .panel {
      border-right: none;
      border-bottom: 1px solid var(--border-strong);
      min-height: 0;
    }
    .panel:last-child { border-bottom: none; }
  }
  @media (max-width: 640px) {
    .triptych { padding: var(--space-8) var(--space-6); }
    .panel { padding: var(--space-8) var(--space-6); }
  }
  @media print { .panel { break-inside: avoid; } }
</style>
